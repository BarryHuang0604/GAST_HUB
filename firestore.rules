rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    // 三人可看彼此的學習統計和共享筆記；只能寫入自己的文件。
    match /users/{uid} {
      allow read: if signedIn();
      allow create, update, delete: if owner(uid);
    }
    // 題庫只從 GitHub Pages 讀取，不允許客戶端寫入 Firestore 題庫。
    match /questions/{qid} { allow read, write: if false; }
    match /words/{wid} { allow read, write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
